// Configuration Cloudflare : un seul Worker sert l'interface React (fichiers statiques de ./dist)
// et l'API (/api/*). Voir le README pour la mise en place.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bookmarks",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookmarks",
      "database_id": "0cded9ae-7320-4f2d-9139-bdbdceed1813",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [{ "binding": "THUMBS", "bucket_name": "bookmarks-thumbs" }],

  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "bookmarks-jobs" }],
    "consumers": [{ "queue": "bookmarks-jobs", "max_batch_size": 3, "max_batch_timeout": 2, "max_retries": 2 }]
  },

  "browser": { "binding": "BROWSER" },

  "vars": {
    "APP_URL": "https://bookmarks.jfleblanc.com",
    "ADMIN_EMAIL": "jf@jfleblanc.com",
    "MAIL_FROM": "bookmarks <jf@jfleblanc.com>"
  },

  // Garde les variables ajoutées dans le tableau de bord Cloudflare lors des déploiements
  "keep_vars": true,

  "observability": { "enabled": true }
}
